# Copy to `.env` — loaded automatically on `pnpm serve` / CLI

# Postgres (optional). If set, used instead of SQLite.
# For local Compose, generate a hex password and use it in both settings (docs/setup.md).
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://envvault:YOUR_GENERATED_PASSWORD@127.0.0.1:5433/envvault
# Hosted example:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=verify-full

# Optional overrides
# PORT=3847
# ENVVAULT_DB=/absolute/path/to/vault.db
# ENVVAULT_REMOTE=http://127.0.0.1:3847

# Security
# ENVVAULT_SIGNUP=invite              # invite (default) | open | closed
# ENVVAULT_PEPPER=                    # long random secret mixed into stored login-proof hashes
# ENVVAULT_SETUP_TOKEN=               # pin the first-run token (else one is generated and logged)
# ENVVAULT_TRUSTED_PROXIES=1          # reverse-proxy hops to trust for X-Forwarded-For (default 0 = ignore)
# ENVVAULT_HSTS=true                  # send HSTS (when TLS terminates in front of the hub)
# ENVVAULT_SESSION_DAYS=14            # session lifetime
# ENVVAULT_AUDIT_RETENTION_DAYS=365   # how long audit events are kept
# ENVVAULT_CORS_ORIGINS=https://app.example.com
# ENVVAULT_PASSWORD=                  # non-interactive CLI login/signup/recover only
# ENVVAULT_TOKEN=                     # CI: service token (evt_...) from Settings → Service tokens
