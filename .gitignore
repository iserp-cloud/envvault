# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dashboard/dist/
packages/*/dist/
*.tsbuildinfo
.envvault/
# Local vault (sessions, SQLite, keys)
.centralizer/

# Environment / secrets
.env
.env.*
.env-*
!.env.example
.dev.vars
.dev.vars.*
.claude/settings.local.json

# Your own deployment config (manifests, helper scripts: hostnames, registries, IPs, secrets).
# It varies per company, so none of it ships; the image and docs/deploy.md are the contract.
deploy/

# Credentials and keys, wherever they land
*.pem
!/test/fixtures/self-signed.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.kubeconfig
kubeconfig*
.kube/
*.tfstate
*.tfstate.*
*.tfvars
.terraform/
.npmrc
.netrc
.aws/
.gcp/
*credentials*.json
service-account*.json
*-sa.json
secrets.*
*.secret
*.secrets

# SQLite sidecars (if created outside .envvault)
*.db
*.db-shm
*.db-wal

# Cloudflare / Wrangler
.wrangler/
.mf/

# Logs & debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# Lockfiles from other package managers (pnpm-lock.yaml is tracked)
package-lock.json
npm-shrinkwrap.json
yarn.lock

# Container hub bundle
dist-hub/


# Private CA and server key made by scripts/self-signed-cert.sh
envvault-tls/

# A file or folder whose name ends in ":" is a database URL that was used as a path by mistake
# (it can contain a password). The hub now refuses such URLs; this is the second line of defence.
*:

# Registry credentials for pulling the operator image: never committed.
operator/config/*pull-secret*.yaml

# Your filled-in copies of the example manifests (examples/k8s, examples/operator). The *.example.yaml files ship.
examples/k8s/secret.yaml
examples/k8s/docker-pull-secret.yaml
operator/config/config-map.yaml
operator/config/install.local.yaml

# The rule `secrets.*` above is for credential files; this is operator source code.
!/operator/internal/controller/secrets.go
