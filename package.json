{
  "name": "envvault-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "EnvVault monorepo — hub server, Worker, dashboard, and CLI package",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "envvault": "tsx packages/cli/src/index.ts",
    "build": "pnpm build:shared && pnpm build:cli && pnpm build:dashboard && pnpm build:hub",
    "build:shared": "pnpm --filter @envvault/shared build",
    "build:cli": "pnpm build:shared && pnpm --filter @iserp/envvault build",
    "build:dashboard": "pnpm --filter dashboard build",
    "build:cf": "pnpm build:dashboard",
    "dev": "pnpm envvault",
    "dev:dashboard": "pnpm build:shared && pnpm --filter dashboard dev",
    "dev:cf": "pnpm build:dashboard && wrangler dev",
    "deploy:cf": "pnpm build:dashboard && wrangler deploy",
    "serve": "tsx src/index.ts serve",
    "migrate": "tsx src/index.ts migrate",
    "publish:cli": "pnpm build:cli && pnpm --filter @iserp/envvault publish --access public --no-git-checks",
    "test": "tsx --test test/*.test.ts",
    "vectors": "tsx scripts/gen-vectors.ts",
    "build:hub": "pnpm build:shared && tsup --config tsup.hub.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@envvault/shared": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "@orpc/client": "^1.14.13",
    "@orpc/server": "^1.14.13",
    "better-sqlite3": "^13.0.2",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "kysely": "^0.29.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "wrangler": "^4.163.0"
  }
}
